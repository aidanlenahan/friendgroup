[Unit]
Description=GEM Web (dev preview)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aidan
Group=devs
WorkingDirectory=/var/www/gem
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm --workspace apps/web run preview -- --host 127.0.0.1 --port 4174 --strictPort
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/gem /tmp
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

NODE_ENV=development
PORT=3000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173
WEB_ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://gem:gem@localhost:5432/gem_dev
REDIS_URL=redis://localhost:6379

AUTH_SECRET=replace-with-at-least-32-characters-secret
JWT_EXPIRES_IN=7d
CALENDAR_WEBHOOK_SECRET=replace-with-long-random-secret

# VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:3000/media/proxy
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-minio-access-key
S3_SECRET_ACCESS_KEY=replace-with-minio-secret-key
S3_BUCKET=gem-media
S3_FORCE_PATH_STYLE=true

# SMTP — any SMTP server; leave blank to disable email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=GEM <noreply@example.com>

# Comma-separated; receives error alert emails from errorReporter.ts
ADMIN_EMAILS=
ERROR_ALERT_EMAILS=

# Beta access controls
REGISTRATION_BETA_REQUIRED=false
REGISTRATION_INVITE_CODE=
GROUP_CREATION_BETA_REQUIRED=false
GROUP_CREATION_INVITE_CODE=
BETA_ADMIN_SECRET=replace-with-long-random-secret

# Media limits (bytes / count)
MEDIA_MAX_FILE_BYTES=10485760
MEDIA_MAX_EVENT_BYTES=209715200
MEDIA_MAX_USER_BYTES=1073741824
MEDIA_MAX_USER_FILES=100
MEDIA_UPLOAD_URL_TTL_SECONDS=900
